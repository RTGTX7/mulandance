  "about": {
    "title": "关于我们",
    "mission": {
      "title": "我们的使命与价值观",
      "mission": "通过舞蹈艺术激发和赋权个人，培养创造力、纪律和社区精神。",
      "values": {
        "excellence": "卓越",
        "excellenceDesc": "我们在舞蹈教育和艺术表达方面坚持最高标准。",
        "inclusivity": "包容性",
        "inclusivityDesc": "舞蹈属于每个人。我们欢迎所有背景和能力的学员。",
        "community": "社区",
        "communityDesc": "我们通过共享的艺术体验建立持久的联系。",
        "innovation": "创新",
        "innovationDesc": "我们在尊重舞蹈传统的同时拥抱新方法。"
      }
    },
    "history": {
      "title": "我们的历史",
      "founded": "成立于1985年",
      "story": "优雅舞蹈学院始于一个小小的梦想。我们的创始人、首席舞者李伟设想了一个空间，让各个年龄段的舞者都能发现舞蹈的变革力量。从这些朴素的起步，我们已经发展成为该地区最受尊敬的舞蹈机构之一，每年 Across 所有舞蹈门类培训超过2000名学员。",
      "expansion": "扩展到第二个工作室以满足不断增长的需求。",
      "newStudio": "在艺术区开设了设施先进的总部工作室。",
      "recognition": "获得区域艺术卓越奖，以表彰对舞蹈教育的杰出贡献。",
      "expansion2": "推出成人教育项目和社区外展计划。",
      "present": "以超过2200名学员的创纪录招生庆祝舞蹈教育39周年。"
    },
    "leadership": {
      "title": "领导层",
      "board": "董事会",
      "artisticStaff": "艺术团队",
      "faculty": "师资团队",
      "founder": "李伟",
      "founderDesc": "创始人兼艺术总监。前国家芭蕾舞团首席舞者，李伟于1985年创立优雅舞蹈学院，致力于让所有人获得世界级的舞蹈教育。",
      "artisticDir": "陈莎拉",
      "artisticDirRole": "艺术总监",
      "artisticDirDesc": "负责所有艺术项目和课程开发。前现代舞团独舞演员，拥有20年教学经验。",
      "opsDir": "威廉姆斯·马库斯",
