# Database
DATABASE_URL=postgresql://dance_user:dance_pass@postgres:5432/dance_org
POSTGRES_DB=dance_org
POSTGRES_USER=dance_user
POSTGRES_PASSWORD=dance_pass

# Application
SECRET_KEY=change_me_in_production
NEXTAUTH_SECRET=change_me_in_production
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://fastapi:8000

# FastAPI
ALLOWED_HOSTS=http://localhost:3000

# Stripe (for donations and payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@dance-org.example.com

# Newsletter (Mailchimp)
MAILCHIMP_API_KEY=...
MAILCHIMP_LIST_ID=...

# Search (PostgreSQL full-text search for MVP)
SEARCH_PROVIDER=postgres

# File Scan (deferred)
