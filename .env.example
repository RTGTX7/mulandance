# Runtime
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change_me_to_a_long_random_secret

# Public URLs
# Local Docker:
PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_HOSTS=http://localhost:3000,http://127.0.0.1:3000

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database
# Current production-safe default is SQLite stored in the mounted data volume.
DATABASE_URL=sqlite:////app/data/app.db

# Persistent content directories inside the backend container.
# Production recommendation: put HOST_DATA_DIR outside the source checkout.
# This survives deleting/re-cloning the code directory before a new pull.
# Local dev can keep the default ./data.
HOST_DATA_DIR=../mulandance-data
DATA_DIR=/app/data
NEWS_FILES_DIR=/app/data/news
UPLOADS_DIR=/app/data/uploads
USE_FILE_STORAGE=true

# Upload / import limits
AI_MAX_URLS=10
AI_MAX_IMAGES_PER_URL=5

# AI defaults. The admin panel can override enabled/base URL/key/model in System Settings.
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60

# Email / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
